{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "v8 契约层共享定义(红旗条目/面板指标/最硬证据/子判定/三元组/节点基座)",
  "$defs": {
    "red_flag_item": {
      "type": "object",
      "required": ["id", "level", "title", "evidence", "source", "node"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "level": { "enum": ["🔴", "🟠", "🟡", "🟢", "ℹ️"] },
        "title": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "source": { "enum": ["script", "nomination"] },
        "node": { "enum": ["quality", "state", "odds", "path"] },
        "metric_refs": { "type": "array", "items": { "type": "string" } },
        "supersedes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "只用于写手提名:被本条更正的脚本红旗 id(脚本判错/期别不对)。被更正的脚本条留在附录D 并注明,不再进首页 Top3、不再上红标;🔴 不能被更正"
        },
        "superseded_by": {
          "type": "string",
          "description": "装配写入(写手别填):本脚本条已被哪条提名更正"
        },
        "supersedes_missing": {
          "type": "boolean",
          "description": "装配写入(写手别填):supersedes 指向的脚本红旗本期没有触发(过期指针)"
        },
        "same_theme_as": {
          "description": "只用于写手提名:本条与哪条红旗(脚本或提名的 id)讲的是同一件事。两条所在的组合并成一个主题,首页 Top3 只出一张卡(排名取主题里最强那组本来的排名,不加分),附录D 照列全部",
          "oneOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
            { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } }
          ]
        },
        "same_theme_missing": {
          "type": "boolean",
          "description": "装配写入(写手别填):same_theme_as 指向的红旗本期不在清单里(过期指针)"
        },
        "display_title": {
          "type": "string",
          "description": "脚本红旗的读者向标题(financial_audit plain_title);不进 id"
        },
        "display_note": {
          "type": "string",
          "description": "脚本红旗的一句后果(financial_audit plain_note);不进 id"
        }
      }
    },
    "panel_indicator": {
      "type": "object",
      "required": ["name", "value", "trend", "peer_percentile", "red_flag_ref", "note", "series"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "trend": { "type": "string", "minLength": 1 },
        "peer_percentile": { "type": ["string", "null"] },
        "red_flag_ref": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "series": { "$ref": "#/$defs/metric_series" }
      }
    },
    "metric_series": {
      "type": ["object", "null"],
      "title": "面板 sparkline 的数值序列 — 填数不填话(票 11)",
      "description": "trend 字段说的是「怎么变的」, 这里是「变的那条线本身」。取不到历史序列就落 null(键必填, 逼写手明说没有), 面板照常渲染, 只是那格没有 sparkline。",
      "required": ["points"],
      "properties": {
        "unit": { "type": "string" },
        "points": {
          "type": "array",
          "minItems": 3,
          "description": "按时间先后排;两点连不成趋势, 所以至少三点",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "description": "期别, 如 2024 / 2026H1" },
              "value": { "type": "number" }
            }
          }
        }
      }
    },
    "hardest_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["text", "mechanism"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "mechanism": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sub_verdict": {
      "type": "object",
      "required": ["question", "judgment", "hardest_evidence"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "judgment": { "type": "string", "minLength": 1 },
        "hardest_evidence": { "$ref": "#/$defs/hardest_evidence" }
      }
    },
    "triad": {
      "type": "object",
      "required": ["state", "odds", "path"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "odds": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "node_base": {
      "type": "object",
      "required": ["node", "verdict"],
      "properties": {
        "verdict": { "type": "string", "minLength": 1 },
        "reused_from": {
          "anyOf": [
            { "$ref": "#/$defs/iso_date" },
            { "type": "null" }
          ]
        },
        "red_flag_nominations": {
          "type": "array",
          "items": { "$ref": "#/$defs/red_flag_item" }
        }
      }
    },
    "iso_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "action_gear": { "enum": ["核心仓", "期权仓", "等证据临界", "不追高", "减仓", "回避"] }
  }
}
